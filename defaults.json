// Trax Combat Enhancements - DEFAULTS (defaults.json)
//
// The one place every setting's default lives. The build embeds this file in the mod: a first
// run writes these values into config.json, a key missing from config.json falls back to them,
// and MCM's Reset and "Revert all to defaults" restore them.
//
// To change a default: edit the value after the colon (true/false, or a number with a dot:
// 0.75), save, build and deploy. Keep every key - the tests check each value's type and range.
//
// The // lines are written by the mod from its list of settings. When a setting's wording,
// range or place changes in the code, rewrite them (every value is kept) from the repo root:
//     dotnet run --project tools/DefaultsTool -- refresh
//
// The game never reads this file for a player's own values - those live in config.json in
// Documents\Mount and Blade II Bannerlord\Configs\TraxCombatEnhancements\
// MCM's "Save current values as a defaults file" writes the values in play as a file like this
// one, next to config.json - copy it over the repo's defaults.json to make them the defaults.
{
  // ==================== Master switch ====================
  // Turn the whole mod off to play a battle exactly as vanilla - for example to fight the same
  // battle with and without it and compare. Off: no damage rolls, no Athletics costs, refill or
  // slow attacks, no bars; the log still records every battle (its summary says mod ON or OFF).
  // Applies live, even mid-battle; switched back on, everyone starts with a full Athletics bar.
  // (true or false)
  "ModEnabled": true,

  // ==================== Damage randomness ====================
  // On: every hit that lands deals a random share of its normal damage (see the spread). Off:
  // damage is the game's own (the rest of the mod still runs).
  // (true or false)
  "DamageRandomEnabled": true,

  // How far a hit's damage may swing up or down, in percent. 50 means a 50-damage hit lands for
  // anything from 25 to 75, rolled fresh on every hit. 0 turns the randomness off.
  // (range 0 to 100)
  "DamageRandomPercent": 50,

  // Randomize hits by swords, axes, maces, spears and fists, and horse-charge bumps.
  // (true or false)
  "DamageRandomMelee": true,

  // Randomize hits by arrows, bolts, sling stones and thrown weapons.
  // (true or false)
  "DamageRandomRanged": true,

  // Also randomize hits that land on horses and other mounts.
  // (true or false)
  "DamageRandomOnMounts": true,

  // Also randomize the damage a shield takes when it blocks a blow. Off: shields wear down at
  // the game's usual pace.
  // (true or false)
  "DamageRandomOnShields": false,

  // ==================== Athletics ====================
  // On: every fighter has an Athletics bar - his stamina, as big as his Athletics skill on the
  // character screen - that his attacks drain and rest refills. Near the top of the bar he
  // fights at full strength; below it his damage, swing speed and run speed fall, down to slow
  // attacks when it is empty. Off: no Athletics bar at all.
  // (true or false)
  "AthleticsEnabled": true,

  // No fighter's Athletics bar is smaller than this, whatever his Athletics skill - so a
  // recruit with skill 20 still gets 50 points (5 blows). 0 = no floor: the bar is exactly the
  // skill (never below 1 point). Changing it mid-battle keeps everyone's share: a fighter at
  // 60% stays at 60%.
  // (range 0 to 1000)
  "AthleticsPoolFloor": 50,

  // Athletics points per point of Athletics skill. 1.0: the bar tops at the skill - skill 180,
  // a bar of 180. Changing it mid-battle keeps everyone's share.
  // (range 0.1 to 5.0)
  "AthleticsPoolPerSkill": 1.0,

  // At or above this share of his own bar a fighter is at full strength: full damage upside,
  // full swing speed, full run speed. Below it each of those falls in a straight line to its
  // lowest value at an empty bar. 100 = only a full bar is full strength.
  // (range 10 to 100)
  "AthleticsPeakPercent": 75,

  // On: a wounded fighter can only use the share of his bar that matches the health he has left
  // - at 75% health, 75% of the bar; the rest is cut at once and never refills while the wound
  // lasts. The full-strength line stays where it was, so a badly wounded fighter never gets
  // back to full strength.
  // (true or false)
  "HealthCapsAthletics": true,

  // Athletics points one attack costs before the hero and leader discounts, whatever the size
  // of the bar - so a bigger Athletics skill means more blows. With the defaults a recruit (a
  // 50 bar) empties after 5 blows, a legionary (130) after 13. 0 = attacks are free.
  // (range 0.0 to 100.0)
  "CostPerBlow": 10.0,

  // On: every attack costs Athletics, landed or not. Off: only attacks that hit something (a
  // body, a shield, a parrying weapon) cost.
  // (true or false)
  "CostOnMiss": true,

  // Heroes (lords, companions and you) pay this share of the cost per blow. 0.75 = a quarter
  // less than a common soldier.
  // (range 0.0 to 2.0)
  "HeroCostMultiplier": 0.75,

  // The hero who leads the fighter's own party (you for your party, a lord for his) pays this
  // share again, on top of the hero discount: 0.75 × 0.75 × 10 = about 5.6 per blow.
  // (range 0.0 to 2.0)
  "PartyLeaderCostMultiplier": 0.75,

  // ==================== Tired fighters ====================
  // Attack speed of a fighter whose Athletics is empty, in percent of normal: swings, thrusts,
  // bow draw, crossbow reload, throws. Between the full-strength line and empty it falls in a
  // straight line. 100 = attacks never slow down.
  // (range 5 to 100)
  "ExhaustedAttackSpeedPercent": 20,

  // On: a tired AI fighter also decides to attack (and to strike back after a parry) less
  // often, looses arrows less readily and aims longer before a shot - by the same factor as his
  // attack speed - so his whole rhythm slows, not only the swing. Blocking is never touched.
  // Off: only the animations slow down. Applies at once, even mid-battle.
  // (true or false)
  "AttackRateAiDecisions": true,

  // On: after each melee swing a tired AI fighter on foot holds his next attack, guard up,
  // until his time between attacks has grown to his fresh rhythm divided by his attack speed -
  // at 50% attack speed one attack every 2 seconds instead of every second. Never you, never
  // riders. Off mid-battle: every held fighter may attack again at once.
  // (true or false)
  "AttackRatePaceHold": true,

  // Top speed on foot of a fighter whose Athletics is empty, times his normal top speed.
  // Between the full-strength line and empty it falls in a straight line, so fresh men overtake
  // tired ones. 1.0 = tired men run as fast as fresh ones.
  // (range 0.1 to 1.0)
  "MinMoveSpeedMultiplier": 0.3,

  // Top speed of a horse whose rider's Athletics is empty, times its normal top speed, on the
  // same straight line. 1.0 = horses never slow down, however tired the rider.
  // (range 0.1 to 1.0)
  "MountMinSpeedMultiplier": 1.0,

  // On: the lucky side of the damage roll shrinks as the attacker tires - at full strength a
  // hit can land up to +50%, halfway down to empty up to +25%, empty never above normal. The
  // unlucky side never changes. Off: every attacker gets the full roll.
  // (true or false)
  "DamageBonusFollowsAthletics": true,

  // ==================== Tired fighters step back ====================
  // On: after a melee swing, a tired AI fighter on foot may step back a little, facing his
  // enemy with his guard up, then return to his place in the formation - so the tired fall back
  // and the fresh take the blows. Never you, never riders, never after a shot or a throw. Off
  // mid-battle: everyone stepping back returns to his formation at once.
  // (true or false)
  "StepBackEnabled": true,

  // Chance, in percent, that a fighter with an empty Athletics bar steps back after a melee
  // swing. It falls in a straight line to 0 at the full-strength line: halfway down, half this
  // chance; at full strength never. 0 = nobody steps back.
  // (range 0 to 100)
  "StepBackMaxChancePercent": 100,

  // How far back a fighter steps, in metres, straight away from the enemy he fights. A tired
  // man walks slowly, so he may not get all the way before the time below runs out.
  // (range 0.5 to 5.0)
  "StepBackDistance": 2.0,

  // How long a step back lasts at most, in seconds. Then his formation takes him again and he
  // walks back to his place.
  // (range 0.3 to 5.0)
  "StepBackSeconds": 1.5,

  // A fighter steps back only while the enemy he fights is at most this many metres away - with
  // nobody close there is nothing to step back from.
  // (range 1.0 to 20.0)
  "StepBackEnemyRange": 4.0,

  // On: a fighter stepping back does not attack - guard up only - until he is back with his
  // formation. Off: he may still strike while he backs away.
  // (true or false)
  "StepBackHoldAttacks": true,

  // At most this many fighters, on all sides together, step back at the same time. It keeps big
  // battles cheap and stops a whole front line from stepping back together.
  // (range 1 to 1000)
  "StepBackMaxAtOnce": 50,

  // ==================== Regeneration ====================
  // How long a fighter must go without attacking before his Athletics starts to refill, counted
  // in blow lengths (see the next setting). 2 × 1.5 s = 3 seconds.
  // (range 0.0 to 20.0)
  "RegenDelayBlowTimes": 2.0,

  // How many seconds one blow counts as, for the rest delay above.
  // (range 0.1 to 10.0)
  "BlowTimeSeconds": 1.5,

  // Seconds to refill from empty to full while standing still or walking.
  // (range 1.0 to 600.0)
  "FullRegenSecondsStanding": 60.0,

  // How fast Athletics refills while running flat out (or riding at the horse's top speed),
  // times the rate at rest. Between a walk and a full run it falls in a straight line. 1.0 =
  // running refills as fast as resting; 0 = no refill at a full run.
  // (range 0.0 to 1.0)
  "RegenMultiplierAtFullRun": 0.5,

  // Up to this share of his current top speed a fighter (or the horse he rides) counts as
  // walking and refills at the full rate. The game walks people at 1.8 m/s and their top speed
  // is about 4 to 5 m/s, so 0.4 covers a walk. 1.0 = any pace refills at the full rate.
  // (range 0.05 to 1.0)
  "WalkEffortFraction": 0.4,

  // ==================== Bars - you and your target ====================
  // Show your own Athletics next to your health bar.
  // (true or false)
  "ShowPlayerBar": true,

  // Show a small Athletics bar for the fighter you are looking or aiming at. Aiming at a horse
  // shows its rider.
  // (true or false)
  "ShowTargetBar": true,

  // How far away, in metres, a fighter you look at still gets a bar.
  // (range 1.0 to 200.0)
  "TargetBarMaxDistance": 30.0,

  // Seconds the target's bar stays after your aim leaves him, so it does not flicker.
  // (range 0.0 to 10.0)
  "TargetBarLingerSeconds": 2.0,

  // Colour of the Athletics bars: green at or above the full-strength line, blue just below it,
  // and yellow once the Athletics left is at or below this percent of the line. With the line
  // at 75% of the bar, 75 turns the bar yellow from about 56% of the bar down.
  // (range 0 to 100)
  "BarYellowBelowPercent": 75,

  // The Athletics bars turn orange once the Athletics left is at or below this percent of the
  // full-strength line (50: half of the line, about 38% of the bar with the line at 75%).
  // (range 0 to 100)
  "BarOrangeBelowPercent": 50,

  // The Athletics bars turn red once the Athletics left is at or below this percent of the
  // full-strength line (25: a quarter of the line, about 19% of the bar with the line at 75%).
  // An empty bar is always red, and its number turns red too.
  // (range 0 to 100)
  "BarRedBelowPercent": 25,

  // ==================== Bars - your squads ====================
  // Show the average Athletics of each of your formations in a bar floating above it.
  // (true or false)
  "ShowFormationBars": true,

  // On: the squad bars are always shown. Off: only while the game shows its own formation
  // markers (marker key held or orders menu open).
  // (true or false)
  "FormationBarsAlways": true,

  // Draw a band showing how far the men's Athletics spreads around the average - on each squad
  // bar and in the orders-menu strip (off: the strip shows the average alone, without its "±
  // 8").
  // (true or false)
  "ShowFormationSpread": true,

  // Width of that band on each side of the average, in standard deviations - the strip's "± 8"
  // is this width in percent of the bar. 1 = about two men in three fall inside it.
  // (range 0.0 to 3.0)
  "FormationSpreadStdDevs": 1.0,

  // How high above the formation's centre its bar floats, in metres.
  // (range 0.0 to 10.0)
  "FormationBarHeight": 3.0,

  // While the orders menu is open, show under each formation card its men's average Athletics ±
  // spread as a slim bar and numbers, for example "72% ± 8" (and their average health).
  // (true or false)
  "ShowInOrderMenu": true,

  // The orders-menu strip (and the squad bars) also show the men's average health left, for
  // example "HP 81%".
  // (true or false)
  "ShowFormationHealth": true,

  // On: the strip sits under each of the game's formation cards (read live, so it follows any
  // resolution, UI scale or order-menu mod that keeps the cards). Off - or whenever the cards
  // cannot be matched - a compact panel at the top of the screen lists the same numbers
  // instead.
  // (true or false)
  "OrderStripUnderCards": true,

  // ==================== Advanced ====================
  // How often your bar and the target's bar update, in seconds. Lower is smoother and costs a
  // little more.
  // (range 0.02 to 1.0)
  "HudRefreshSeconds": 0.1,

  // Length of your Athletics bar, in the game's UI pixels (the 1920 x 1080 layout; the game's
  // UI scale applies). 205 matches the inside of the vanilla health bar above it.
  // (range 40 to 800)
  "PlayerBarWidth": 205,

  // Thickness of your Athletics bar, in the game's UI pixels.
  // (range 2 to 40)
  "PlayerBarHeight": 12,

  // Distance from the right edge of the screen to the right end of your Athletics bar, in the
  // game's UI pixels. 62 lines it up under the vanilla health bar.
  // (range 0 to 1800)
  "PlayerBarOffsetRight": 62,

  // Distance from the bottom of the screen to your bar's row (the word Athletics, the number
  // and the bar), in the game's UI pixels. 54 puts it just under the vanilla health and horse
  // bars.
  // (range 0 to 1000)
  "PlayerBarOffsetBottom": 54,

  // Font size of the orders-menu strip's numbers, in the game's UI pixels.
  // (range 8 to 30)
  "OrderStripTextSize": 13,

  // Distance from the bottom of a formation card to the top of its numbers, in the game's UI
  // pixels. The numbers sit at the left and right ends, leaving the middle to the game's order
  // icons.
  // (range -40 to 60)
  "OrderStripTextOffset": 1,

  // Distance from the bottom of a formation card to the top of its Athletics bar, in the game's
  // UI pixels. 20 puts it just under the game's order icons, which hang 20 px below a card.
  // (range -40 to 60)
  "OrderStripBarOffset": 20,

  // Thickness of the orders-menu strip's Athletics bar, in the game's UI pixels.
  // (range 1 to 20)
  "OrderStripBarHeight": 4,

  // How far the strip's numbers and bar keep in from a card's left and right edges, in the
  // game's UI pixels.
  // (range 0 to 40)
  "OrderStripSideMargin": 2,

  // Where the fallback panel sits (used when the cards cannot be matched, or with the strip
  // under the cards off): distance from the top of the screen, in the game's UI pixels. It is
  // centred left to right.
  // (range 0 to 1000)
  "OrderPanelOffsetTop": 80,

  // Width of the fallback panel, in the game's UI pixels.
  // (range 120 to 900)
  "OrderPanelWidth": 300,

  // How often the squad averages and spreads are recomputed, in seconds.
  // (range 0.05 to 2.0)
  "FormationStatsRefreshSeconds": 0.25,

  // Write every damage roll, blow and exhaustion to trax_combat.log (rate-limited, so a big
  // battle cannot flood it). Off: only loading, settings, battle start and end, battle
  // summaries and errors.
  // (true or false)
  "VerboseLogging": false
}
