  "HudRefreshSeconds": 0.1,

  // Length of your Athletics bar, in the game's UI pixels (the 1920 x 1080 layout; the game's
  // UI scale applies). 205 matches the inside of the vanilla health bar above it.
  // (range 40 to 800)
  "PlayerBarWidth": 205,

  // Thickness of your Athletics bar, in the game's UI pixels.
  // (range 2 to 40)
  "PlayerBarHeight": 12,

  // Distance from the right edge of the screen to the right end of your Athletics bar, in the
  // game's UI pixels. 62 lines it up under the vanilla health bar.
  // (range 0 to 1800)
  "PlayerBarOffsetRight": 62,

  // Distance from the bottom of the screen to your bar's row (the word Athletics, the number
  // and the bar), in the game's UI pixels. 30 leaves room for the Attack recovery bar above it,
  // both just under the vanilla health and horse bars.
  // (range 0 to 1000)
  "PlayerBarOffsetBottom": 30,

  // Length of the Attack recovery bar, in the game's UI pixels. 205 matches your Athletics bar
  // under it.
  // (range 40 to 800)
  "RecoveryBarWidth": 205,

  // Thickness of the Attack recovery bar, in the game's UI pixels. The seconds inside it need
  // about 12.
  // (range 2 to 40)
  "RecoveryBarHeight": 14,

  // How far above your Athletics bar's row the Attack recovery bar's row sits (bottom to
  // bottom), in the game's UI pixels. 24 = right on top of it. It moves with your bar.
  // (range -400 to 600)
  "RecoveryBarOffsetAbove": 24,

  // How far above your Athletics bar's row the sprint bar's row sits (bottom to bottom), in the
  // game's UI pixels - as long and thick as the Attack recovery bar. 46 = right on top of the
  // recovery bar. It moves with your bar.
  // (range -400 to 600)
  "SprintBarOffsetAbove": 46,

  // Font size of the orders-menu strip's numbers, in the game's UI pixels.
  // (range 8 to 30)
  "OrderStripTextSize": 13,

  // Distance from the bottom of a formation card to the top of its numbers, in the game's UI
  // pixels. The numbers sit at the left and right ends, leaving the middle to the game's order
  // icons.
  // (range -40 to 60)
  "OrderStripTextOffset": 1,

  // Distance from the bottom of a formation card to the top of its Athletics bar, in the game's
  // UI pixels. 20 puts it just under the game's order icons, which hang 20 px below a card.
  // (range -40 to 60)
  "OrderStripBarOffset": 20,

  // Thickness of the orders-menu strip's Athletics bar, in the game's UI pixels.
  // (range 1 to 20)
  "OrderStripBarHeight": 4,

  // Distance from the bottom of a formation card to the top of its ready count ("ready 34/50"),
  // in the game's UI pixels. 24 puts it right under the strip's bar, filling the gap to the
  // next card; a cell that would leave the screen is lifted to its edge.
  // (range -40 to 80)
  "OrderStripReadyOffset": 24,

  // How far the strip's numbers and bar keep in from a card's left and right edges, in the
  // game's UI pixels.
  // (range 0 to 40)
  "OrderStripSideMargin": 2,

  // Where the fallback panel sits (used when the cards cannot be matched, or with Strip under
  // the cards off): distance from the top of the screen, in the game's UI pixels. It is centred
  // left to right.
  // (range 0 to 1000)
  "OrderPanelOffsetTop": 80,

  // Width of the fallback panel, in the game's UI pixels.
  // (range 120 to 900)
  "OrderPanelWidth": 300,

  // Font size of the numbers under the formation markers, in the game's UI pixels.
  // (range 8 to 30)
  "AltMarkerTextSize": 16,

  // Distance from the bottom of a formation marker (its distance number) to the top of our
  // numbers, in the game's UI pixels. Negative moves them up over the marker.
  // (range -200 to 200)
  "AltMarkerOffset": 2,

  // Length of the slim Athletics bar under the marker's numbers, in the game's UI pixels. 60 =
  // as wide as the marker's distance row.
  // (range 20 to 300)
  "AltMarkerBarWidth": 60,

  // Thickness of that bar, in the game's UI pixels. 0 = no bar, the numbers alone.
  // (range 0 to 20)
  "AltMarkerBarHeight": 3,

  // Length of the fever mark above a man near the camera, in the game's UI pixels (smaller far
  // away - 60% at 60 m). The fill inside it is the fever left.
  // (range 4 to 100)
  "FeverMarkWidth": 22,

  // Thickness of the fever mark, in the game's UI pixels (smaller far away).
  // (range 2 to 30)
  "FeverMarkHeight": 5,

  // How high above a man's feet his fever mark floats, in metres - the mark's bottom edge sits
  // there (his Athletics bar sits above it). The game's own ALT icon over your men is at about
  // 2 m. A rider's bars sit 1 m higher.
  // (range 1.0 to 4.0)
  "FeverMarkHeightMetres": 2.5,

  // Length of the Athletics bar above a man near the camera, in the game's UI pixels (smaller
  // far away - 60% at 60 m). The fill inside it is his Athletics left.
  // (range 4 to 100)
  "AthleticsMarkWidth": 22,

  // Thickness of the Athletics bar above a man, in the game's UI pixels (smaller far away).
  // (range 2 to 30)
  "AthleticsMarkHeight": 5,

  // Space between a man's Athletics bar and the fever bar under it, in the game's UI pixels.
  // The fever bar's place is kept while he has no fever, so his Athletics bar never jumps.
  // (range 0 to 20)
  "AthleticsMarkGap": 2,

  // How often the formations' averages (Athletics, spread, health) for the orders-menu strip
  // and the formation markers are worked out - every formation of every side - in seconds of
  // battle time.
  // (range 0.05 to 2.0)
  "FormationStatsRefreshSeconds": 0.25,

  // A TEST TOOL for the coming impact system (staggers, dropped shields, knockdowns): while on,
  // every battle applies fixed loud values - half the landed kicks knock the man down, blocks
  // stun three times longer for half the men, every other kicked man reels at half speed, the
  // first block every 10 s staggers the blocker, a kicked man drops his shield, one knockdown
  // blow of the mod's own every 20 s - and the log's summary says per lever whether the game
  // followed (WORKS / FAILS / UNSEEN). Leave it off to play. Live.
  // (true or false)
  "ImpactSpike": false,

  // Also write every damage roll, blow, step back and AI pause to trax_combat.log, rate-limited
  // so a big battle cannot flood it. These lines carry a ~ before their tag and are the only
  // ones a trim cuts. Off: loading, settings, battle start and end, first-time events,
  // summaries and errors only.
  // (true or false)
  "VerboseLogging": false,

  // Largest size of the mod's log, trax_combat.log, in megabytes. Past it the oldest verbose
  // lines are cut, down to about half the limit; every other line - loading, settings, battle
  // start and end, first-time events, summaries, errors - is kept.
  // (range 1 to 100)
  "LogMaxMegabytes": 8
}
