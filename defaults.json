  // (range 5.0 to 40.0)
  "CavalryFlockTimidRadiusMetres": 15.0,

  // The flocking riders of his kind this close to him are "with him" - his group.
  // (range 5.0 to 100.0)
  "CavalryFlockGatherRadiusMetres": 25.0,

  // Each flocking rider rides to his own place in the flock, about this far from the next -
  // horses never stack on one point.
  // (range 1.0 to 10.0)
  "CavalryFlockSeparationMetres": 3.5,

  // A flocking rider rides to his group's centre led this many seconds ahead along the flock's
  // heading (at the flock's speed, at least a canter) - the flock keeps moving instead of
  // converging on a still dot. 0 = the centre itself.
  // (range 0.0 to 5.0)
  "CavalryFlockLeadSeconds": 2.0,

  // While flocking a rider's own AI strikes only what is right beside him and does not ride off
  // for a target - the game's per-rider behaviour weights, re-applied after every order (the
