  // (range 0.05 to 5.0)
  "ImpactGuardShieldRight": 1.0,

  // How well a parrying weapon takes a blow, times its weight number.
  // (range 0.05 to 5.0)
  "ImpactGuardParry": 0.8,

  // How well a shield held on the WRONG side takes a blow, times the shield's weight number - a
  // fraction of the right side's.
  // (range 0.05 to 5.0)
  "ImpactGuardShieldWrong": 0.4,

  // The guard of a man hit clean or kicked: his body only.
  // (range 0.05 to 5.0)
  "ImpactGuardNone": 1.0,

  // A stagger's chance starts at this pressure and climbs along an S-curve to its ceiling at a
  // pressure of 1 (an empty even man).
  // (range 0.0 to 0.95)
  "ImpactStaggerFrom": 0.0,

  // A dropped shield needs at least this much pressure before it can happen at all.
