  // (range 5.0 to 180.0)
  "CavalryFlockMaxSeconds": 45.0,

  // ==================== Impact: staggers, shield drops, knockdowns ====================
  // A kick or shield bash that lands may knock a tired man down or make him drop his shield,
  // and makes him reel longer the more tired he is. Off: kicks and bashes are the game's own.
  // (true or false)
  "ImpactKicksEnabled": true,

  // A blow blocked on the WRONG side may stagger the tired blocker, knock him down or make him
  // drop his shield; a correct block (right-side shield, parry) breaks him mainly on a big
  // mismatch - it is mostly the attacker's risk (the riposte). Off: blocks are the game's own.
  // (true or false)
  "ImpactBlocksEnabled": true,

  // A weapon blow that lands unblocked may stagger a tired man longer or knock him down. Off:
  // hits are the game's own.
  // (true or false)
  "ImpactHitsEnabled": true,

  // A man who blocks on the right side or parries may stagger the attacker who swung at him -
  // more likely the more tired and outmatched the attacker is: a tired man flailing into a good
