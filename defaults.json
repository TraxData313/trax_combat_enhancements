  // (range 0.0 to 60.0)
  "CourageShockSeconds": 6.0,

  // At full shock the odds he needs x (1 + this %): at 100 three hits in the window double
  // them, one hit adds a third.
  // (range 0 to 500)
  "CourageShockWeightPercent": 100,

  // A man in his FEVER (the charge's surge - Aggression and fever) who is NOT shaken by a hit
  // presses on whatever the odds - the charge goes in. Once hit, his fever only lowers the odds
  // he needs: to this share while it is full, back to 100% as it burns out. When it fades, the
  // weak side's men pull back. 100 = the fever does not lower the odds of a hit man.
  // (range 0 to 100)
  "CourageFeverPercent": 40,

  // A hero (a lord, a companion) needs this share of the odds a soldier needs - they lead from
  // the front. Their armour and level already make them count for a lot.
  // (range 10 to 200)
  "CourageHeroPercent": 75,

  // A timid man becomes brave again only when the odds are this much ABOVE what he needs (25 =
  // 25% more) - so he does not flicker between brave and timid at the edge.
  // (range 0 to 200)
  "CourageHysteresisPercent": 25,

  // Once timid a man stays timid at least this long, whatever the odds do.
  // (range 0.0 to 10.0)
  "CourageMinTimidSeconds": 2.0,

  // Now and then a timid man steps in: one who is not shaken by a hit, stands among his mates
  // and has an enemy within 8 m rolls this chance about every half second, times his Athletics
  // bar (a tired man surges less). A surge makes him brave for the seconds below - he steps in
  // and swings, then the normal rules take him back. At 5 a fresh man surges about every 10 s.
  // 0 = never.
  // (range 0 to 100)
  "CourageSurgeChancePercent": 5,

  // How long a surge makes a timid man brave.
  // (range 0.0 to 30.0)
  "CourageSurgeSeconds": 4.0,

  // A timid man walks back only when he is farther than this from his group's centre; within it
  // he has arrived and holds (half of it when shocked - shaken men pack in).
  // (range 1.0 to 30.0)
  "CourageRegroupRadiusMetres": 5.0,

  // A timid man with at least this many mates within the courage circle is with his group - he
  // holds there instead of walking (twice as many when shocked). 0 = timid men never walk back,
  // they only hold.
  // (range 0 to 30)
  "CourageRegroupMates": 4,

  // A timid man walks to the nearest bigger group of his own side - the centre of his allies
  // within this distance, when there are enough of them (below) - like sheep pushed into the
  // flock; else to his formation's centre of mass. 0 = always the formation's centre.
  // (range 0.0 to 100.0)
  "CourageFlockRadiusMetres": 20.0,

  // How many allies within the distance above make a group worth running to.
  // (range 1 to 100)
  "CourageFlockMinMen": 6,

  // A timid man whose group is far (below), or who has several enemies near him, sprints back -
  // spending only what he holds above his reserve (below). In a PANIC he sprints at once and
  // may spend nearly everything. Needs the sprint and "AI soldiers sprint on new orders" on.
  // (true or false)
  "CourageSprintBack": true,

  // A timid man sprints back when his group's centre is farther than this.
  // (range 0.0 to 100.0)
  "CourageSprintMetres": 12.0,

  // ...or when at least this many enemies are within the courage circle.
  // (range 1 to 30)
  "CourageSprintEnemies": 3,

  // A timid man's sprint back spends only what he holds above this share of his full sprint
  // store - a bit of his sprint, the rest kept for the fight.
  // (range 0 to 100)
  "CourageSprintKeepPercent": 50,

  // A SHOCKED man whose odds are below this share of what he needs PANICS: he sprints back at
  // once, whatever the distance, and keeps only the panic reserve below. 0 = no panic.
  // (range 0 to 100)
  "CouragePanicOddsPercent": 50,

  // In a panic a man sprints everything above this share of his sprint store - his order's
  // reserve and the normal sprint-back reserve do not hold him. 0 = all of it: panic uses all
  // their energy.
  // (range 0 to 100)
  "CouragePanicSprintKeepPercent": 0,

  // While timid a man's own AI fights only an enemy within reach (below) and otherwise keeps to
  // his place - the game's per-man behaviour weights, re-applied after every order (the game
  // resets them). Brave again: the game's own. Off: timid men only walk back, their AI's
  // eagerness untouched.
  // (true or false)
  "CourageTightenWeights": true,

  // A timid man still fights an enemy this close - beyond it his own place wins. 2 m is about a
  // sword's reach.
  // (range 0.5 to 6.0)
  "CourageTimidMeleeMetres": 2.0,

  // ==================== Cavalry flocking (AI) ====================
  // A rider's EAGERNESS is his Athletics bar (halved when he is alone among enemies, below). At
  // or above this he is free - the game's own charging, again and again. Below it he flocks
  // with his kind. With the Athletics system off everyone is at 100%.
  // (range 10 to 100)
  "CavalryFlockFreeEagerPercent": 75,

  // A flocking rider charges alone again only once his eagerness is this far above the line -
  // so he does not flicker between flocking and charging at the edge.
  // (range 0 to 30)
  "CavalryFlockHysteresisPercent": 5,

  // The group-size curve's middle point: a rider at this eagerness wants the group size below
  // before he attacks again. At the free line he wants 1 (himself); between, a straight line.
  // (range 5 to 95)
  "CavalryFlockMidEagerPercent": 40,

  // How many riders of his kind (him included) a half-tired rider wants within reach before he
  // attacks again.
  // (range 1 to 20)
  "CavalryFlockMidGroupSize": 4,

  // An exhausted rider wants this share of his kind's riders in his formation before he attacks
  // again (never fewer than the half-tired size); a straight line from the middle point down to
  // empty. A flock goes in when the group has the size its riders' AVERAGE eagerness wants.
  // (range 0 to 100)
  "CavalryFlockExhaustedSharePercent": 65,

  // A rider alone among many enemies - courage's odds (Courage and cohesion: the toughness of
  // his side against the enemy's near him, with tiredness, morale, shock and heroes) - counts
  // at half his eagerness, so he looks for his kind even when he is fresh. Needs Courage and
  // cohesion on (its numbers are used).
  // (true or false)
  "CavalryFlockTimid": true,

  // The circle a rider weighs his side against the enemy in - wider than a man on foot's, a
