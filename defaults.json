  // answer to IMPACT §8 question 1).
  // (range 0.0 to 5.0)
  "ImpactDamageWeight": 0.0,

  // A weapon (or shield) of this weight counts 1 in the impact and guard numbers; heavier
  // counts more by the exponent below.
  // (range 0.1 to 10.0)
  "ImpactRefWeightKg": 1.5,

  // Impact and guard grow with (weight ÷ reference weight) to this power (0.5: a 6 kg shield
  // guards twice as well as a 1.5 kg one). 0 = weight does not count.
  // (range 0.0 to 2.0)
  "ImpactWeightExponent": 0.5,

  // A swing (or thrust) of this speed - the weapon's own number, slowed by a tired man's slower
  // swing - counts 1 in the impact; faster counts more by the exponent below.
  // (range 10.0 to 200.0)
  "ImpactRefSwingSpeed": 90.0,

  // The impact grows with (swing speed ÷ reference speed) to this power. 0 = speed does not
  // count.
  // (range 0.0 to 3.0)
  "ImpactSpeedExponent": 1.0,

  // Maces, hammers, clubs and other blunt blows hit this many times harder in the impact
  // numbers.
  // (range 0.1 to 3.0)
  "ImpactBluntFactor": 1.3,

  // Swords, axes and other cutting blows count this many times in the impact numbers.
  // (range 0.1 to 3.0)
  "ImpactCutFactor": 1.0,

  // Thrusts and other piercing blows count this many times in the impact numbers (a point
  // pushes less than an edge or a head).
  // (range 0.1 to 3.0)
  "ImpactPierceFactor": 0.8,

  // A kick's impact number (a 1.2 kg sword's swing is about 0.9).
  // (range 0.0 to 5.0)
  "ImpactKickFactor": 1.2,

  // A shield bash's impact = the shield's weight number times this.
  // (range 0.0 to 5.0)
  "ImpactBashFactor": 1.0,

  // The weapon skill of the man who strikes (Athletics for a kick, one-handed for a bash) and
  // of the man who guards (one-handed for a shield, his weapon's skill for a parry, Athletics
  // for no guard) scale his side: skill 0 counts this much, rising in a straight line to the
  // next value at skill 300.
  // (range 0.1 to 2.0)
  "ImpactSkillMinFactor": 0.75,

  // What skill 300 (and above) counts: a recruit (20) 0.78, a veteran (200) 1.08, a 300 lord
  // 1.25 with the defaults.
  // (range 0.1 to 3.0)
  "ImpactSkillMaxFactor": 1.25,

  // How well a shield held on the right side takes a blow, times the shield's weight number (a
