<Project Sdk="Microsoft.NET.Sdk">

  <!-- The OFFLINE SMOKE TEST: runs the real module assembly on .NET Framework with the game's own
       DLLs - no game launched - to check what can be checked without Anton: every type loads with
       MCM ABSENT (the game's GetTypes() scan), the MCM bridge stands down cleanly, the config file
       flows (first run, hand edit kept on an MCM save, re-read, broken file backed up, missing keys
       added), then with MCM PRESENT the settings page is built by MCM's real fluent builder and
       its sliders, preset and Done are driven through MCM's own objects. tools\deploy.ps1 runs it.
       Needs the game and MCM installed (same paths as the module build). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OfflineSmoke</AssemblyName>
    <RootNamespace>TraxCombat.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TraxCombat.Module\TraxCombat.Module.csproj" />
  </ItemGroup>

  <!-- Compile-only; at run time Program.Resolve hands these out from the game / Workshop folders
       (and REFUSES MCM until the "MCM present" phase). -->
  <ItemGroup>
    <Reference Include="MCMv5">
      <HintPath>$(McmBinFolder)\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Step 19: the smoke builds the game's own MissionObjective with a TextObject name (the hideout boss
         objective the refill watches for). -->
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The HUD checks (step 6): the views are MissionViews (Native's View assembly); a HudFrame
         carries an Agent (a DotNetObject). -->
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.DotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade.View">
      <HintPath>$(GameFolder)\Modules\Native\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.View.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
