<Prefab>
  <!--
    Trax Combat Enhancements - THE ORDERS-MENU STRIP (step 9, DESIGN §3 item 4).
    While the orders menu is open: under each of the game's formation cards, a cell as wide as the
    card - the numbers "72% ± 8" (left) and "HP 81%" (right) just under the card, the middle left
    free for the game's order icons, and under them a slim bar: the men's mean Athletics (@Fill,
    coloured by their average f), a translucent ± band (@BandLow → @BandHigh: the FillBarWidget's
    ChangeWidget spans exactly that) and a thin tick at the peak line.
    The cells are placed in SCREEN PIXELS read from the vanilla cards every frame (Scaled* widget
    properties take pixels - AI_NOTES "Step 9"); the rest is in UI pixels of the 1080p layout
    (OrderStrip* settings), so the game's UI scale applies.
    FALLBACK: the same list bound a second time as the rows of a compact panel at the top centre
    (@PanelShown) - used when the cards cannot be matched or OrderStripUnderCards is off.
    Data: Hud\OrderStripVM.cs (the root) and OrderStripCellVM (each item of {Cells}). Every @binding's
    property has EXACTLY the widget property's type (float / int / Color / bool / string) - Gauntlet
    converts only strings. Native sprites and brushes only. A passive overlay: no widget takes mouse
    events (RTS Camera makes the cards clickable - nothing here may catch those clicks).
    The offline smoke parses this file: widget types, attributes, brushes, sprites, bindings (the
    item template against the item ViewModel), every ViewModel property drawn.
  -->
  <Window>
    <Widget Id="TraxOrderStrip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" DoNotPassEventsToChildren="true">
      <Children>

        <!-- THE STRIP: one cell per card slot (FormationClass 0..7), each placed on its card in pixels -->
        <Widget Id="Cells" DataSource="{Cells}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@StripShown" DoNotAcceptEvents="true">
          <ItemTemplate>
            <Widget Id="Cell" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top" ScaledSuggestedWidth="@CellWidth" ScaledPositionXOffset="@PositionX" ScaledPositionYOffset="@PositionY" IsVisible="@IsShown" DoNotAcceptEvents="true">
              <Children>

                <TextWidget Id="Athletics" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="@SideMargin" MarginTop="@TextMarginTop" Brush="AgentHUD.Interaction.Text" Brush.FontSize="@TextSize" Text="@AthleticsText" DoNotAcceptEvents="true" />

                <TextWidget Id="Health" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="@SideMargin" MarginTop="@TextMarginTop" Brush="AgentHUD.Interaction.Text" Brush.FontSize="@TextSize" Text="@HealthText" IsVisible="@HealthShown" DoNotAcceptEvents="true" />

                <!-- the bar: dark ground, the mean fill, the ± band over it, the peak tick -->
                <Widget Id="Bar" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="@BarHeight" VerticalAlignment="Top" MarginTop="@BarMarginTop" MarginLeft="@SideMargin" MarginRight="@SideMargin" Sprite="BlankWhiteSquare_9" Color="#141414D0" DoNotAcceptEvents="true">
                  <Children>
                    <FillBarWidget Id="AthleticsBar" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" FillWidget="AthleticsFill" MaxAmountAsFloat="1" InitialAmountAsFloat="@Fill" DoNotAcceptEvents="true">
                      <Children>
                        <Widget Id="AthleticsFill" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" Sprite="BlankWhiteSquare_9" Color="@FillColor" DoNotAcceptEvents="true" />
                      </Children>
                    </FillBarWidget>
                    <FillBarWidget Id="Spread" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" FillWidget="SpreadLow" ChangeWidget="SpreadBand" CustomChangeColor="true" MaxAmountAsFloat="1" InitialAmountAsFloat="@BandLow" CurrentAmountAsFloat="@BandHigh" DoNotAcceptEvents="true">
                      <Children>
                        <Widget Id="SpreadLow" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" DoNotAcceptEvents="true" />
                        <Widget Id="SpreadBand" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" Sprite="BlankWhiteSquare_9" Color="#FFFFFF5A" DoNotAcceptEvents="true" />
                      </Children>
                    </FillBarWidget>
                    <FillBarWidget Id="PeakBar" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" FillWidget="PeakSpan" MaxAmountAsFloat="1" InitialAmountAsFloat="@PeakLine" DoNotAcceptEvents="true">
                      <Children>
                        <Widget Id="PeakSpan" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" DoNotAcceptEvents="true">
                          <Children>
                            <Widget Id="PeakMarker" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1" HorizontalAlignment="Right" Sprite="BlankWhiteSquare_9" Color="#F2F2F2C8" DoNotAcceptEvents="true" />
                          </Children>
                        </Widget>
                      </Children>
                    </FillBarWidget>
                  </Children>
                </Widget>

              </Children>
            </Widget>
          </ItemTemplate>
        </Widget>

        <!-- THE FALLBACK PANEL: top centre, one row per formation with men, in the cards' order -->
        <Widget Id="Panel" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="@PanelWidth" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="@PanelOffsetTop" IsVisible="@PanelShown" Sprite="BlankWhiteSquare_9" Color="#000000A0" DoNotAcceptEvents="true">
          <Children>
            <ListPanel Id="Rows" DataSource="{Cells}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="8" MarginRight="8" MarginTop="6" MarginBottom="4" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
              <ItemTemplate>
                <ListPanel Id="Row" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="4" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@IsShown" DoNotAcceptEvents="true">
                  <Children>

                    <Widget Id="Line" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" DoNotAcceptEvents="true">
                      <Children>
                        <TextWidget Id="Name" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" Brush="AgentHUD.Interaction.Text" Brush.FontSize="@TextSize" Text="@Name" DoNotAcceptEvents="true" />
                        <ListPanel Id="Numbers" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" StackLayout.LayoutMethod="HorizontalLeftToRight" DoNotAcceptEvents="true">
                          <Children>
                            <TextWidget Id="RowAthletics" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="AgentHUD.Interaction.Text" Brush.FontSize="@TextSize" Text="@AthleticsText" DoNotAcceptEvents="true" />
                            <TextWidget Id="RowHealth" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="12" Brush="AgentHUD.Interaction.Text" Brush.FontSize="@TextSize" Text="@HealthText" IsVisible="@HealthShown" DoNotAcceptEvents="true" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>

                    <Widget Id="RowBar" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="@BarHeight" MarginTop="1" Sprite="BlankWhiteSquare_9" Color="#141414D0" DoNotAcceptEvents="true">
                      <Children>
                        <FillBarWidget Id="RowAthleticsBar" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" FillWidget="RowFill" MaxAmountAsFloat="1" InitialAmountAsFloat="@Fill" DoNotAcceptEvents="true">
                          <Children>
                            <Widget Id="RowFill" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" Sprite="BlankWhiteSquare_9" Color="@FillColor" DoNotAcceptEvents="true" />
                          </Children>
                        </FillBarWidget>
                        <FillBarWidget Id="RowSpread" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" FillWidget="RowSpreadLow" ChangeWidget="RowSpreadBand" CustomChangeColor="true" MaxAmountAsFloat="1" InitialAmountAsFloat="@BandLow" CurrentAmountAsFloat="@BandHigh" DoNotAcceptEvents="true">
                          <Children>
                            <Widget Id="RowSpreadLow" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" DoNotAcceptEvents="true" />
                            <Widget Id="RowSpreadBand" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" Sprite="BlankWhiteSquare_9" Color="#FFFFFF5A" DoNotAcceptEvents="true" />
                          </Children>
                        </FillBarWidget>
                        <FillBarWidget Id="RowPeakBar" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" FillWidget="RowPeakSpan" MaxAmountAsFloat="1" InitialAmountAsFloat="@PeakLine" DoNotAcceptEvents="true">
                          <Children>
                            <Widget Id="RowPeakSpan" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" DoNotAcceptEvents="true">
                              <Children>
                                <Widget Id="RowPeakMarker" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1" HorizontalAlignment="Right" Sprite="BlankWhiteSquare_9" Color="#F2F2F2C8" DoNotAcceptEvents="true" />
                              </Children>
                            </Widget>
                          </Children>
                        </FillBarWidget>
                      </Children>
                    </Widget>

                  </Children>
                </ListPanel>
              </ItemTemplate>
            </ListPanel>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
