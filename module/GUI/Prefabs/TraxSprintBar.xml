<Prefab>
  <!--
    Trax Combat Enhancements - YOUR SPRINT BAR (step 33, DESIGN §3 - Anton: "a short burst of speed").
    Above the Attack recovery bar, its right end lined up with your Athletics bar: the words (@LabelText - "Sprint 6.2 s",
    the seconds of sprint stored) and a slim bar. Inside the bar, bottom to top: the dark inside, the fill (@Fill - the
    store's share of its size; @FillColor grey below the start mark, blue when a sprint can start, yellow while you
    sprint) and the start mark (@MarkOffset from the inside's left edge - SprintMinStartPercent of it; @MarkShown).
    Data: Hud\SprintBarVM.cs. Every @binding's VM property has EXACTLY the widget property's type (float / Color / bool /
    string) - Gauntlet converts only strings (AI_NOTES "Step 6").
    Native sprites and brushes only (BlankWhiteSquare_9, AgentHUD.Interaction.Text). Sizes and places are bound from the
    settings (RecoveryBarWidth / RecoveryBarHeight, PlayerBarOffsetRight, PlayerBarOffsetBottom + SprintBarOffsetAbove), in UI
    pixels of the 1080p layout - the game's UI scale multiplies them. A passive overlay: no widget takes mouse events. The
    offline smoke parses this file like the other bars'.
    Step 86: the words split in three - the word (@WordText "Sprint"), the KEY HINT and the seconds (@SecondsText "6.2 s") - so the
    hint sits right after the word: "Sprint (Ctrl) 6.2 s" on mouse and keyboard (@KeyText / @KeyTextShown, a size smaller, the label's
    colour), the game's own controller glyph on a pad (vanilla's InputKeyVisualWidget, @KeyGlyph = the InputKey name, @KeyGlyphShown -
    the sprite General\InputKeys\..., ui_group1, always loaded). The row is anchored right, so the bar never moves; a hidden hint takes
    no room.
  -->
  <Window>
    <Widget Id="TraxSprint" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" DoNotPassEventsToChildren="true">
      <Children>

        <ListPanel Id="Row" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="@OffsetRight" MarginBottom="@OffsetBottom" StackLayout.LayoutMethod="HorizontalLeftToRight" IsVisible="@IsShown" DoNotAcceptEvents="true">
          <Children>

            <TextWidget Id="Label" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginRight="4" Brush="AgentHUD.Interaction.Text" Brush.FontSize="15" Brush.FontColor="#BDBDBDFF" Text="@WordText" DoNotAcceptEvents="true" />

            <!-- step 86: the key hint - "(Ctrl)" as text, or the game's controller glyph -->
            <TextWidget Id="KeyHint" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginRight="4" Brush="AgentHUD.Interaction.Text" Brush.FontSize="13" Brush.FontColor="#BDBDBDFF" Text="@KeyText" IsVisible="@KeyTextShown" DoNotAcceptEvents="true" />
            <InputKeyVisualWidget Id="KeyGlyph" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="20" SuggestedHeight="20" VerticalAlignment="Center" MarginRight="4" KeyID="@KeyGlyph" IsVisible="@KeyGlyphShown" DoNotAcceptEvents="true" />

            <TextWidget Id="Seconds" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginRight="8" Brush="AgentHUD.Interaction.Text" Brush.FontSize="15" Brush.FontColor="#BDBDBDFF" Text="@SecondsText" DoNotAcceptEvents="true" />

            <!-- the bar: a thin light frame -->
            <Widget Id="Bar" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@BarWidth" SuggestedHeight="@BarHeight" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#C8C8C8B4" DoNotAcceptEvents="true">
              <Children>

                <!-- inside the 1-px frame: dark, the fill on top, the start mark over it -->
                <Widget Id="Inside" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="1" MarginRight="1" MarginTop="1" MarginBottom="1" Sprite="BlankWhiteSquare_9" Color="#141414F0" DoNotAcceptEvents="true">
                  <Children>
                    <FillBarWidget Id="SprintFillBar" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" FillWidget="SprintFill" MaxAmountAsFloat="1" InitialAmountAsFloat="@Fill" DoNotAcceptEvents="true">
                      <Children>
                        <Widget Id="SprintFill" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" Sprite="BlankWhiteSquare_9" Color="@FillColor" DoNotAcceptEvents="true" />
                      </Children>
                    </FillBarWidget>
                    <Widget Id="StartMark" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Left" MarginLeft="@MarkOffset" Sprite="BlankWhiteSquare_9" Color="#FFFFFFE6" IsVisible="@MarkShown" DoNotAcceptEvents="true" />
                  </Children>
                </Widget>

              </Children>
            </Widget>

          </Children>
        </ListPanel>

      </Children>
    </Widget>
  </Window>
</Prefab>
